PORT=5000
MONGODB_URI=mongodb://localhost:27017/collab_platform
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=36500d
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Default admin account — created automatically on first server start
# if no admin exists in the database. Change these before deploying!
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nexuscollab.com
ADMIN_PASSWORD=Admin@123
